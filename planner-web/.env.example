# Add your AI provider's API key to .env, keeping this example blank.
API_KEY=

# Default model, you can change this, but I recommend using the default model for best results and you might have to change the reasoning level.
AI_MODEL=deepseek-v4.1-flash-1017

# Base URL for the chat API; the app appends /chat/completions.
AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
